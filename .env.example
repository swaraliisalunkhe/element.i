# ===== Copy this file to ".env" and fill in your own values. NEVER commit ".env". =====

# ----- General -----
APP_ENV=development

# ----- Backend server -----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ----- Frontend origin (for CORS) -----
FRONTEND_ORIGIN=http://localhost:3000

# ----- Storage (paths are relative to the repository root) -----
DATA_DIR=data
DATABASE_URL=sqlite:///data/code_apex.db
EVIDENCE_DIR=data/evidence

# ----- Sample assessment app under test (Member B) -----
SAMPLE_APP_URL=http://localhost:8001
TARGET_RESET_PATH=/reset
SAMPLE_ASSESSMENT_DURATION=300

# ----- Agents (Member C) -----
HEADLESS=true
TESTSUITE_MAX_CASES=25
TRACE_ENABLED=true

# ----- AI provider: "gemini", "claude", or "none" (none = no real AI calls) -----
LLM_PROVIDER=none
LLM_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ----- Frontend (Member D reads this one; must start with NEXT_PUBLIC_) -----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000